{
  "name": "namelet",
  "version": "0.0.4",
  "description": "Tiny, flexible name generator for JavaScript and TypeScript.",
  "homepage": "https://github.com/author/library#readme",
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "license": "MIT",
  "author": "Mohamed Alawlaqi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "lint": "vp lint",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "release": "bumpp"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
